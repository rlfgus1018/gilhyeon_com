{
  "name": "gilhyeon_com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:migrate:dry": "node --env-file=.env.local scripts/db-migrate.mjs --dry-run",
    "test:db": "node --env-file-if-exists=.env.test.local --test \"tests/db/**/*.test.mjs\"",
    "db:verify": "node --env-file=.env.local scripts/db-verify.mjs",
    "db:users": "node --env-file=.env.local scripts/db-users.mjs",
    "db:grant-admin": "node --env-file=.env.local scripts/db-grant-admin.mjs",
    "db:e2e-cleanup": "node --env-file=.env.local scripts/db-e2e-cleanup.mjs",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "katex": "^0.18.10",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.5.0",
    "simple-icons": "^16.33.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-directive": "^3.1.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
